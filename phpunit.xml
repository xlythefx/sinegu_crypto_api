<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="TRADE_ALERT_EMAILS" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Payment rollout switches: pinned so a developer's local .env (TRON_PUBLIC=true, provider tron) cannot leak into the suite. -->
        <env name="TRON_PUBLIC" value="false"/>
        <env name="PAYMENTS_DEFAULT_PROVIDER" value="coinsbuy"/>
        <!-- Higgsfield (Admin → Creatives): pinned empty so a developer's real key can never make the suite call the API. Tests set config explicitly and fake every request. -->
        <env name="HIGGSFIELD_KEY_ID" value=""/>
        <env name="HIGGSFIELD_KEY_SECRET" value=""/>
        <!-- Claude (Admin → Creatives' AI writer): pinned empty for the same reason. Tests bind a fake CreativeWriter and never call Anthropic. -->
        <env name="ANTHROPIC_API_KEY" value=""/>
        <!-- The developer error bot: pinned empty so the suite can never DM anyone. Tests set config and fake Telegram. -->
        <env name="DEV_BOT_TOKEN" value=""/>
        <env name="DEV_BOT_CHAT_ID" value=""/>
        <env name="DEV_BOT_WEBHOOK_SECRET" value=""/>
    </php>
</phpunit>
