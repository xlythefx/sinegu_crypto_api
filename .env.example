APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@pixel-alpha.com"
MAIL_FROM_NAME="Pixel Alpha"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared secret for the Python trading engine (X-Engine-Secret header)
ENGINE_SECRET=

# Trading engine (trading-flask) — proxy target + its webhook secret
BINANCE_ENGINE_WEBHOOK_SECRET=
ENGINE_URL_LOCAL=http://127.0.0.1:5010
ENGINE_URL_PROD=http://127.0.0.1:5010

# Taker commission per side used to ESTIMATE a closed trade's fee until its
# receipts arrive (TradingFee). Binance USDⓈ-M 0.05%, MEXC USDT-M 0.02%.
BINANCE_TAKER_FEE_RATE=0.0005
MEXC_TAKER_FEE_RATE=0.0002

# ── Direct USDT-TRC20 payments (no provider) ─────────────────────────────
# The receiving wallet is a PUBLIC address on a public chain — detecting a
# payment is a read of public data, so nothing here is a spending credential.
# TRON_*_API_KEY is a TronGrid rate-limit key and is optional.
#
# Two independent switches, in this order:
#   TRON_PUBLIC=true            → the rail becomes visible to every trader
#   PAYMENTS_DEFAULT_PROVIDER=tron → and then becomes the default one
# Until the first is true only `developer` accounts see it, which is what lets
# the whole flow be rehearsed on production without a customer noticing.
PAYMENTS_DEFAULT_PROVIDER=coinsbuy
TRON_PUBLIC=false

# Mainnet — real money. Leave TRON_MAINNET_ADDRESS empty until a real wallet
# exists; every entry point reports "not configured" rather than guessing.
TRON_MAINNET_ADDRESS=
TRON_MAINNET_API_KEY=
# Tether's own contract, verified on chain (name TetherToken, 6 decimals).
TRON_MAINNET_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Nile testnet — where `developer` accounts pay, on EVERY box including prod.
# Look the test token up on nile.tronscan.org; there is deliberately no default.
TRON_NILE_ADDRESS=
TRON_NILE_API_KEY=
TRON_NILE_USDT_CONTRACT=

# On WAMP, point this at a cacert.pem or outbound TLS fails with cURL error 60.
TRON_CACERT=

